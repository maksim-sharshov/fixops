# --- Backend (FastAPI) ---
# Postgres
POSTGRES_NAME=fixops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fixops
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_NAME=0

# DeepSeek / LLM
DEEPSEEK_TOKEN=

# Logging
APP_SERVICE_NAME=fixops
APP_ENV=production
APP_LOG_DIR=logs

# Пути к проектам внутри/снаружи FixOps-контейнера
PATH_HOST_PROJECTS_ROOT=/home/virtu/projects
PATH_FIXOPS_PROJECTS_ROOT=/projects

# Анализ ошибок
ANALYSIS_LOG_TAIL_LINES=50
ANALYSIS_MAX_FIX_ATTEMPTS=3

# --- Frontend (Vite, build-time) ---
VITE_API_URL=http://localhost:8000

# --- Deploy ---
# Владелец образов в GHCR (owner GitHub-репозитория, в нижнем регистре)
IMAGE_OWNER=disciplined-pioneer
IMAGE_TAG=latest
